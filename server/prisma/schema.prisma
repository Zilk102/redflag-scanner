generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Analysis {
  id           String   @id @default(uuid()) @db.Uuid
  originalText String
  result       Json
  isPaid       Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@map("analyses")
}

