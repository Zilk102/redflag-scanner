generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Analysis {
  id           String   @id @default(uuid()) @db.Uuid
  originalText String
  result       Json
  isPaid       Boolean  @default(false)
  consentGiven Boolean  @default(false)
  consentAt    DateTime?
  createdAt    DateTime @default(now())

  @@map("analyses")
}

model Scan {
  id        String   @id @default(uuid()) @db.Uuid
  text      String
  result    Json
  isPaid    Boolean  @default(false)
  consentGiven Boolean  @default(false)
  consentAt    DateTime?
  createdAt DateTime @default(now())

  @@map("scans")
}
